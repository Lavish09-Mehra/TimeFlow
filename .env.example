# ============================================================
# TimeFlow global environment example
# ------------------------------------------------------------
# Copy this file to .env and adjust values for your setup.
# Never commit a real .env file containing secrets.
# Only variables prefixed with VITE_ are exposed to the frontend.
# ============================================================

# Public app metadata
VITE_APP_NAME=TimeFlow
VITE_APP_ID=com.timeflow.app
VITE_APP_VERSION=1.0.0

# Default page background
VITE_DEFAULT_BG="#36454F"

# Android SDK levels
VITE_ANDROID_MIN_SDK=24
VITE_ANDROID_TARGET_SDK=36

# Public profile and project links
VITE_GITHUB_URL=https://github.com/Lavish09-Mehra/TimeFlow
VITE_LINKEDIN_URL=https://www.linkedin.com/in/lavish09dev
